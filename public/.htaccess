# Apache — SPA fallback + redirect da URL antiga do WordPress
Options -MultiViews

RewriteEngine On

# URL antiga do site WordPress → nova home (seção contato)
RewriteRule ^contato/?$ /#contato [NE,R=301,L]

# SPA fallback: rotas sem arquivo físico servem o index
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Cache longo para assets com hash no nome
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
</IfModule>
